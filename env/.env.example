NEAR_NETWORK_ID=mainnet

AMM_TOKEN1_ID=token1.near
AMM_TOKEN2_ID=token2.near

# TEE mode
TEE_ENABLED=true
SOLVER_REGISTRY_CONTRACT=solver-registry.near
SOLVER_POOL_ID=0
# NEAR_NODE_URLS=

# non-TEE mode
# NEAR_ACCOUNT_ID=solver1.near
# NEAR_PRIVATE_KEY=ed25519:privatekeyprivatekeyprivatekeyprivatekeypriv

# APP_PORT=3000
# LOG_LEVEL=info
# NEAR_NODE_URL=
# RELAY_WS_URL=wss://solver-relay-v2.chaindefuser.com/ws
# INTENTS_CONTRACT=intents.near

# Solver mode
# SOLVER_MODE=public

# Confidential mode
# SOLVER_MODE=confidential
# PRIVATE_RELAY_WS_URL=wss://f3x8k2m9a7.chaindefuser.com/ws
# Confidential Intents contract ID used in signed quote payloads.
# PRIVATE_INTENTS_CONTRACT=intents.far
# PRIVATE_INTENTS_CONTRACT_SALT=e110f317
# PRIVATE_TREASURY_ACCOUNT_ID=51e8f94d77b5e90dc9852ca6113771e11e8382ce69473a75e313e41665de7cbe
# ONE_CLICK_BASE_URL=https://1click.chaindefuser.com
# Stable identifier for this running solver instance.
# SOLVER_INSTANCE_ID=amm-solver-1
# Partner JWT from the Partners dashboard; used for both 1Click and private relay auth.
# PARTNER_JWT=

# MARGIN_PERCENT=0.3
# ONE_CLICK_API_ONLY=false

# 1Click confidential liquidity example
# ONE_CLICK_ASSET_ID=nep141:wrap.near
# Amount is in smallest token units; for 24-decimal wNEAR this is 0.1 wNEAR.
# ONE_CLICK_AMOUNT=100000000000000000000000
